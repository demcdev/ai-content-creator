# Saltos de línea: git decide solo en los archivos de texto y no toca los que ya están en CRLF dentro del repositorio.
* text=auto

# Los hooks de git deben ir siempre con LF (si no, bash los rechaza).
.githooks/* text eol=lf

# Binarios: nunca se convierten ni se comparan como texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.mov binary
